# Valeurs de développement. Les vraies valeurs vivent hors dépôt (infra/.env sur le serveur).
APP_ENV=dev
APP_SECRET=change-me-dev-only
TOKEN_SECRET=change-me-dev-only-token
DATABASE_URL="postgresql://eagle:eagle@127.0.0.1:5432/eagle?serverVersion=16&charset=utf8"
PUBLIC_URL=http://localhost:8000
APP_CALLBACK_URL=eagle://auth
# Laissés vides : la connexion correspondante est simplement désactivée.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_AUDIENCE=com.projetrondo.padelbuddy
