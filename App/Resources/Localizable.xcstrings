    "Les matchs et scores de ce tournoi seront définitivement effacés de cet iPhone." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This tournament's matches and scores will be permanently erased from this iPhone."
