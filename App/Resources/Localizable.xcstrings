          "stringUnit" : {
            "state" : "translated",
            "value" : "The formats"
          }
        }
      }
    },
    "Les informations saisies seront perdues." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What you entered will be lost."
