<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Manifeste de confidentialité d'EAGLE (anciennement Padel Buddy).
  - Aucun suivi (tracking), aucun domaine de suivi, aucun SDK tiers.
  - Données collectées : aucune dans la version publiée (tout reste sur l'iPhone).
    À l'activation du partage (CloudKit) ou des comptes (api_url), déclarer ici : contenu des
    tournois (OtherUserContent) et, pour les comptes, identifiant, nom, e-mail — tous liés à
    l'utilisateur, pour le fonctionnement de l'app (voir docs/COMPTES.md).
  - API à justifier : UserDefaults, pour l'identifiant aléatoire de l'appareil propre à l'app
    (raison CA92.1 : données lues et écrites par l'app elle-même).
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
